@page "/desc"
<PageTitle>Desc</PageTitle>
@rendermode InteractiveServer

<h3>Class descriptions</h3>
<div class="container">
    <div class="stats_block">
        <label>Class: </label>
        <select @bind="charClass" @bind:after="ApplyClassStats">
        @* <select> *@
            <option value="Warrior">&#x2694; Warrior</option>
            <option value="Mage">&#129668; Mage</option>
            <option value="Archer">&#127993; Archer</option>
            <option value="Bard">
                &#127931; Bard
            </option>
            <option value="Druid">&#127794; Druid</option>
        </select>
    </div>

    <div class="show">
        <p class="show_class">@charClass</p>
        <hr />
        <p>Default stats: </p>
        <p>Strength: @strength</p>
        <p>Dexterity: @dexterity</p>
        <p>Intelligence: @intelligence</p>
        <p>Wisdom: @wisdom</p>
        <p>Charisma: @charisma</p>
        <hr />
        <p>Class description: @description</p>
    </div>
</div>

@code {
    private string errorMessage = "";

    private void SaveChar()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(charName))
        {
            errorMessage = "Please enter a char name!";
            return;
        }
        foreach (var existingchar in Cards.Roster)
        {
            if (existingchar.Name.ToLower() == charName.ToLower())
            {
                errorMessage = "A char with this name already exists!";
                return;
            }
        }

        Cards.Roster.Add(new CharCard { Name = charName, Class = charClass, Str = strength, Dex = dexterity, Int = intelligence, Wis = wisdom, Cha = charisma });

        charName = "";
        ApplyClassStats();
    }

    private string charName = "Unit";
    private string charClass = "Warrior";
    private int availablePoints = 8;

    private int strength = 5;
    private int dexterity = 4;
    private int intelligence = 1;
    private int wisdom = 3;
    private int charisma = 2;

    private int minStr = 5;
    private int minDex = 4;
    private int minInt = 1;
    private int minWis = 3;
    private int minCha = 2;

    private string description = "The warrior is a melee fighter that fights stuff.";

    private void ApplyClassStats()
    {
        availablePoints = 8;

        if (charClass == "Warrior") { minStr = 5; minDex = 4; minInt = 1; minWis = 3; minCha = 2; description = "The warrior is a melee fighter that fights stuff."; }
        else if (charClass == "Mage") { minStr = 1; minDex = 2; minInt = 5; minWis = 3; minCha = 2; description = "The mage is a smart fella that shoots fireballs."; }
        else if (charClass == "Archer") { minStr = 2; minDex = 5; minInt = 1; minWis = 3; minCha = 2; description = "The archer is sneaky and shoots arrows into your knees."; }
        else if (charClass == "Bard") { minStr = 2; minDex = 4; minInt = 1; minWis = 3; minCha = 5; description = "The bard is gonna sleep with the dragon."; }
        else if (charClass == "Druid") { minStr = 4; minDex = 1; minInt = 2; minWis = 5; minCha = 3; description = "The druid is a greenpeace activist."; }

        strength = minStr;
        dexterity = minDex;
        intelligence = minInt;
        charisma = minCha;
        wisdom = minWis;
    }

    private void IncStr() { if (availablePoints > 0) { strength++; availablePoints--; } }
    private void DecStr() { if (strength > minStr) { strength--; availablePoints++; } }

    private void IncDex() { if (availablePoints > 0) { dexterity++; availablePoints--; } }
    private void DecDex() { if (dexterity > minDex) { dexterity--; availablePoints++; } }

    private void IncInt() { if (availablePoints > 0) { intelligence++; availablePoints--; } }
    private void DecInt() { if (intelligence > minInt) { intelligence--; availablePoints++; } }

    private void IncWis() { if (availablePoints > 0) { wisdom++; availablePoints--; } }
    private void DecWis() { if (wisdom > minWis) { wisdom--; availablePoints++; } }

    private void IncCha() { if (availablePoints > 0) { charisma++; availablePoints--; } }
    private void DecCha() { if (charisma > minCha) { charisma--; availablePoints++; } }
}
