RK4 <- function(f, x, y, h) {
k1 <- f(x, y)
k2 <- f(x + h/2, y + (h/2)*k1)
k3 <- f(x + h/2, y + (h/2)*k2)
k4 <- f(x + h,   y + h*k3)
y + (h/6) * (k1 + 2*k2 + 2*k3 + k4)
}
source("~/ujep/NUM/zapocet-3-7/prace.r")
