install.packages("fpp3")
library(fpp3)
library(fpp3)
library(TSA)
# vstupni data
recent_production <- aus_production |>
filter(year(Quarter) >= 1992)
# linearni model
fit_beer <- recent_production |>
model(TSLM(Beer ~ trend() + season()))
report(fit_beer)
library(fpp3)
library(forecast)
