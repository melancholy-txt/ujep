PlotQQ(residuals(lm(cislo ~ kategorie)))
lm(cislo ~ kategorie)
residuals(lm(cislo ~ kategorie))
tapply(cislo, kategorie, shapiro.test)
bartlett.test(cislo ~ kategorie)
anova(lm(cislo ~ kategorie))
